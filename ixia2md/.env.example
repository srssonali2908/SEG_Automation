# Copy to .env for local use. In production these come from your secret manager, never from a file in git.
CCMS_URL=https://ccms.example.com
CCMS_USER=svc-ixia2md
CCMS_PASSWORD=
# Alternative to user/password: an existing IxiaAuth cookie value
CCMS_AUTH_COOKIE=
CCMS_VERIFY_TLS=true

# ASSUMPTIONS to confirm with IXIASOFT (see README)
CCMS_LOGIN_METHOD=POST
CCMS_LOGIN_USER_FIELD=userName
CCMS_LOGIN_PASSWORD_FIELD=password
CCMS_PUBLISHED_STATUSES=published
CCMS_VERSION_FIELD=version
CCMS_ORIGIN_FIELD=originIdentifier

DITA_OT_HOME=/opt/dita-ot
MD_FLAVOR=markdown_github
OUTPUT_ROOT=./runs
KEEP_DITA_SOURCE=false
FAIL_ON_QUALITY_FAIL=false
# Optional: score against a reference baseline instead of the DITA source (see tools/)
QA_BASELINE=
